# Copiar a cluster/.env y ajustar a la máquina destino.

# Carpeta del host con los CSV de AWID3 (estructura: <N.Ataque>/<Ataque>_<k>.csv).
# Ruta absoluta o relativa a la carpeta cluster/.
AWID_DATA_DIR=../AWID/csv

# Recursos por nodo. Máquina de 8 GB: valores por defecto. Máquina de 16+ GB: 4g / 3g / 2-4 cores.
NODE_MEM_LIMIT=2g
SPARK_WORKER_MEMORY=1536m
SPARK_WORKER_CORES=2

# Puertos publicados en el host (cambiar si están ocupados)
PORT_HDFS_UI=9870
PORT_SPARK_UI=8080
PORT_APP_UI=4040
PORT_HISTORY=18080
